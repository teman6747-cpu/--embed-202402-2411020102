--cpu Cortex-M4.fp
"matrixkey\startup_stm32f407xx.o"
"matrixkey\main.o"
"matrixkey\gpio.o"
"matrixkey\stm32f4xx_it.o"
"matrixkey\stm32f4xx_hal_msp.o"
"matrixkey\stm32f4xx_hal_rcc.o"
"matrixkey\stm32f4xx_hal_rcc_ex.o"
"matrixkey\stm32f4xx_hal_flash.o"
"matrixkey\stm32f4xx_hal_flash_ex.o"
"matrixkey\stm32f4xx_hal_flash_ramfunc.o"
"matrixkey\stm32f4xx_hal_gpio.o"
"matrixkey\stm32f4xx_hal_dma_ex.o"
"matrixkey\stm32f4xx_hal_dma.o"
"matrixkey\stm32f4xx_hal_pwr.o"
"matrixkey\stm32f4xx_hal_pwr_ex.o"
"matrixkey\stm32f4xx_hal_cortex.o"
"matrixkey\stm32f4xx_hal.o"
"matrixkey\stm32f4xx_hal_exti.o"
